        <mxCell id="13" value="" style="shape=line;strokeColor=#666666;dashed=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1604" y="120" width="2" height="700" as="geometry" />
        </mxCell>
        <mxCell id="14" value="1. health check every 5s" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;dashed=1;" edge="1" parent="1" source="5" target="9">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="710" y="160" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="15" value="2. no response for 3 consecutive checks" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;dashed=1;" edge="1" parent="1" source="9" target="5">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="710" y="250" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="16" value="3. notifyWorkerFailed(worker)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="5" target="7">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="300" y="340" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="17" value="4. if worker owned completed MAP data:&lt;br&gt;invalidate dependent REDUCE tasks" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="7" target="13">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1390" y="430" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="18" value="5. requeue assigned MAP/REDUCE tasks&lt;br&gt;without consuming retry budget" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="7" target="11">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1080" y="520" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="19" value="6. replay lost MAP tasks" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="7" target="11">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1080" y="610" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="20" value="7. completed MAP locations" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="11" target="7">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1080" y="700" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="21" value="8. rebuild REDUCE task list and restart reduce phase" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="7" target="13">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1390" y="790" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="22" value="9. continue REDUCE on surviving workers" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="7" target="11">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1080" y="880" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="23" value="Task-level retry policy:&lt;br&gt;FAILED or MISSING task status increments the attempt counter.&lt;br&gt;After MAX_TASK_RETRIES = 3 the whole job fails." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="760" width="350" height="100" as="geometry" />
        </mxCell>
        <mxCell id="24" value="Transport-level transient errors are re-queued without consuming a retry.&lt;br&gt;Worker disappearance is handled as a separate failure mode." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="760" width="420" height="100" as="geometry" />
        </mxCell>
        <mxCell id="25" value="This is the key design choice that preserves correctness:&lt;br&gt;if a worker dies after MAP completion, its local intermediate files are lost,&lt;br&gt;so the master replays the affected MAP tasks before resuming REDUCE." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1090" y="760" width="520" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
