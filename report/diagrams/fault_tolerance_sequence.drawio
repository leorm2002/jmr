        <mxCell id="12" value="Reduce plan" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;strokeWidth=2;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="1520" y="40" width="170" height="60" as="geometry" />
