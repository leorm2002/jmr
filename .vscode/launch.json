        {
            "type": "java",
            "name": "PreparaDati",
            "request": "launch",
            "mainClass": "com.example.PreparaDati",
            "projectName": "my-mapreduce-job",
            "args": "${workspaceFolder}\\data\\raw_data ${workspaceFolder}\\data\\serialized_data"
