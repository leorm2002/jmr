    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "MyWcJobJ",
            "request": "launch",
            "classPaths": [
                "${workspaceFolder}\\my-mapreduce-job\\target\\my-mapreduce-job-1.0-SNAPSHOT-jar-with-dependencies.jar",
            ],
            "mainClass": "com.example.MyWcJob",
            "args": [
                "${workspaceFolder}\\data\\serialized_data",
                "${workspaceFolder}\\my-mapreduce-job\\target\\my-mapreduce-job-1.0-SNAPSHOT-jar-with-dependencies.jar",
                "localhost",
                "8080"
            ]
        },
        {
            "type": "java",
            "name": "WorkerLauncher",
            "request": "launch",
            "mainClass": "it.jmr.worker.WorkerLauncher",
            "projectName": "jmr-worker",
            "vmArgs": "-Djava.net.preferIPv4Stack=true",
            "args": "-w w1 -p 8081 -sd ${workspaceFolder}"
        },
        {
            "type": "java",
            "name": "MasterLauncher",
            "request": "launch",
            "mainClass": "it.jmr.master.MasterLauncher",
            "projectName": "jmr-master",
            "vmArgs": "-Djava.net.preferIPv4Stack=true",
            "args": "-p 8080 -sd ${workspaceFolder}"
        },
        {
            "type": "java",
            "name": "Worker2Launcher",
            "request": "launch",
            "mainClass": "it.jmr.worker.WorkerLauncher",
            "projectName": "jmr-worker",
            "vmArgs": "-Djava.net.preferIPv4Stack=true",
            "args": "-w w2 -p 8082 -sd ${workspaceFolder}"
        },
        {
            "type": "java",
            "name": "Worker3Launcher",
            "request": "launch",
